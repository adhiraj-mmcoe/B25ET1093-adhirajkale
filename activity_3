#include <iostream>
using namespace std;
void inputArray(int arr[], int size){
    for(int i=0; i<size; i++){
    cin >> arr[i];
    }
}
void outputArray(int arr[], int size){
    for(int i=0; i<size; i++){
    cout << arr[i] << " ";
    }
}
void swap(int &a, int &b){
    int temp = a;
    a = b;
    b = temp;
}
void ascending(int arr[], int size){
    for (int i = 0; i < size - 1; i++) {
        for (int j = 0; j < size - i - 1; j++) {
            if (arr[j] > arr[j + 1]) {
                swap(arr[j],arr[j+1]);
            }
        }
    }
}

void descending(int arr[], int size){
    for (int i = 0; i < size - 1; i++) {
        for (int j = 0; j < size - i - 1; j++) {
            if (arr[j] < arr[j + 1]) {
                swap(arr[j],arr[j+1]);
            }
        }
    }
}

int main() {
    int arr[10], size;
    cout << "Enter the size of the array: ";
    cin >> size;
   
    cout << "Enter an array: ";
    inputArray(arr, size);
   
    cout << "The array you entered is: ";
    outputArray(arr, size);
   
    cout << endl;
    cout << "Ascending order is: ";
    ascending(arr, size);
    for(int i=0; i<size; i++){
        cout << arr[i] << " ";
    }
   
    cout << endl;
    cout << "Descending order is: ";
    descending(arr, size);
    for(int i=0; i<size; i++){
        cout << arr[i] << " ";
    }

    return 0;
}

