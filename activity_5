#include <iostream>
using namespace std;

void employee(string name, int id){
    cout << "Name of employee: " << name << endl;
    cout << "ID of employee: " << id << endl << endl;
}

void employee(string name, int id, string department){
    cout << "Name of employee: " << name << endl;
    cout << "ID of employee: " << id << endl;
    cout << "Department of employee: " << department << endl << endl;
}

void employee(string name, int id, string department, int pay){
    cout << "Name of employee: " << name << endl;
    cout << "ID of employee: " << id << endl;
    cout << "Department of employee: " << department << endl;
    cout << "Pay of employee: ₹" << pay << endl << endl;
}

int main() 
{
    employee("Ram", 115546);
    employee("Shyam", 115547, "IT");
    employee("Arjun", 115548, "Marketing", 45000000);
    return 0;
}
