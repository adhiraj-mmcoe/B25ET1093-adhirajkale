#include <iostream>
using namespace std;

class Complex {
    float real, imag;

public:
    Complex(float r = 0, float i = 0) {
        real = r;
        imag = i;
    }

    void accept() {
        cin >> real >> imag;
    }

    Complex operator+(Complex c) {
        return Complex(real + c.real, imag + c.imag);
    }

    Complex operator-(Complex c) {
        return Complex(real - c.real, imag - c.imag);
    }

    Complex operator*(Complex c) {
        return Complex(real * c.real - imag * c.imag,
                       real * c.imag + imag * c.real);
    }

    Complex operator/(Complex c) {
        float d = c.real * c.real + c.imag * c.imag;

        return Complex((real * c.real + imag * c.imag) / d,
                       (imag * c.real - real * c.imag) / d);
    }

    void display() {
        cout << real;
        if (imag >= 0)
            cout << " + j" << imag;
        else
            cout << " - j" << -imag;
        cout << endl;
    }
};

int main() {
    Complex c1, c2;

    cout << "First Number" << endl << "Enter real and imaginary parts: ";
    c1.accept();

    cout << "Second Number" << endl <<"Enter real and imaginary parts: ";
    c2.accept();

    cout << "c1 + c2 = ";
    (c1 + c2).display();

    cout << "c1 - c2 = ";
    (c1 - c2).display();

    cout << "c1 * c2 = ";
    (c1 * c2).display();

    cout << "c1 / c2 = ";
    (c1 / c2).display();

    return 0;
}
